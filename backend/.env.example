# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# M-Pesa Environment
MPESA_ENV=sandbox
# Options: 'sandbox' for testing, 'production' for live

# Backend Configuration
PORT=3001
BACKEND_URL=http://localhost:3001
# For production, use your deployed URL: https://your-app.herokuapp.com

# Security (optional)
API_SECRET=your-secret-key-for-securing-endpoints
